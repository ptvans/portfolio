{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "redirects": [
    { "source": "/protos", "destination": "/protos/", "permanent": true },
    { "source": "/huebrew", "destination": "/huebrew/", "permanent": true },
    { "source": "/relationship-matrix", "destination": "/relationship-matrix/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/protos/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
